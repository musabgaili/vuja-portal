APP_NAME="VujaDe Platform"
APP_ENV=local
APP_KEY=
# Keep false in any non-local environment — true leaks stack traces, env vars and queries.
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Default to "log" so a fresh install works offline. Switch to "resend" and set
# RESEND_API_KEY in production to actually deliver mail.
MAIL_MAILER=log
RESEND_API_KEY=
MAIL_FROM_ADDRESS="no-reply@auth.vujadesa.com"
MAIL_FROM_NAME="VujaDe Platform"

VITE_APP_NAME="${APP_NAME}"

# Moyasar payment form + server verification. Add test keys first, then switch to
# live keys only after the sandbox flow and HTTPS webhook have been verified.
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=
MOYASAR_API_URL=https://api.moyasar.com
MOYASAR_CURRENCY=SAR
MOYASAR_LINK_TTL_HOURS=48

# Scope Planner PDF engine — "mpdf" (default, pure PHP) or "browsershot" (headless Chrome).
# Browsershot needs Node + Puppeteer + Chromium on the server (see deploy notes).
SCOPE_PDF_ENGINE=mpdf
# Browsershot binary paths (only if not auto-detected on PATH):
SCOPE_NODE_BINARY=
SCOPE_NPM_BINARY=
SCOPE_CHROME_PATH=
SCOPE_BROWSERSHOT_NO_SANDBOX=true
SCOPE_BROWSERSHOT_TIMEOUT=120

# --- Mobile API (Flutter) ---
MOBILE_APP_SCHEME=vujade
MOBILE_TOKEN_TTL_DAYS=90
# Keep false for the internal team app (managers invite staff). Flip on for client self-serve.
MOBILE_SOCIAL_AUTO_REGISTER=false
MOBILE_ANDROID_PACKAGE=com.vujade.portal
MOBILE_ANDROID_SHA256=
MOBILE_IOS_TEAM_ID=
MOBILE_IOS_BUNDLE_ID=com.vujade.portal
MOBILE_IOS_APP_ID=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Web + Android + iOS client IDs, comma-separated (ID token `aud` allow-list).
GOOGLE_CLIENT_IDS=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
APPLE_CLIENT_ID=
APPLE_CLIENT_IDS=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
